# PostgreSQL container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=postgres

# PostgreSQL connections from inside the Docker network
DATABASE_URL=postgresql://postgres:replace_with_postgres_password@db:5432/postgres
ALT_DATABASE_URL=postgresql://postgres:replace_with_postgres_password@db:5432/projects_database
LAB8_DATABASE_URL=postgresql://postgres:replace_with_postgres_password@db:5432/sqli

# PostgreSQL connection from your Mac
HOST_DATABASE_URL=postgresql://postgres:replace_with_postgres_password@localhost:5433/postgres

# MongoDB container settings
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=replace_with_mongo_password

# MongoDB connections from inside Docker and from your Mac
MONGO_URL=mongodb://mongoadmin:replace_with_mongo_password@mongo:27017/?authSource=admin
HOST_MONGO_URL=mongodb://mongoadmin:replace_with_mongo_password@localhost:27018/?authSource=admin