# Database connection properties for CS 345 activity.
postgreSQLDriver = org.postgresql.Driver

# PostgreSQL is case sensitive for database names;
# be sure to keep "umassmmc" in all-lowercase as done here.
postgreSQLUrl = jdbc:postgresql://db:5432/umassmmc

# These work on the dev container
# You may need to adapt if you use a different setup
postgreSQLUser = postgres
postgreSQLPassword = mypass
